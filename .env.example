# ============================================
# Supabase 数据库配置
# ============================================
# 方式1：使用连接池（推荐生产环境）
DATABASE_URL="postgresql://postgres.[项目ID]:[密码]@aws-0-[区域].pooler.supabase.com:6543/postgres"
# 方式2：直接连接（用于 Prisma migrations）
DIRECT_URL="postgresql://postgres.[项目ID]:[密码]@aws-0-[区域].pooler.supabase.com:5432/postgres"

# ============================================
# NextAuth 认证配置
# ============================================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="运行 openssl rand -base64 32 生成"

# OAuth - Google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OAuth - WeChat（可选）
WECHAT_APP_ID=""
WECHAT_APP_SECRET=""

# ============================================
# Cloudflare R2 文件存储（可选，可用 Supabase Storage 替代）
# ============================================
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="baby-planet"
R2_PUBLIC_URL="https://your-r2-domain.com"

# Supabase Storage（免费 1GB，可替代 R2）
SUPABASE_URL="https://[项目ID].supabase.co"
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ============================================
# Web Push 推送通知
# ============================================
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_MAILTO="mailto:your@email.com"

# ============================================
# Brevo 邮件通知（免费 300封/天）
# ============================================
BREVO_API_KEY=""
BREVO_SENDER_EMAIL=""
BREVO_SENDER_NAME="宝贝星球"
